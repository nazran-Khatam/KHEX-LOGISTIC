rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }
  }
}
