{
  "entities": {
    "order": {
      "title": "Order",
      "description": "Represents a transaction order and its shipping status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who placed the order." },
        "orderDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "shipped", "delivered"] },
        "trackingNumber": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "shippingAddress": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "movement": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "location": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      },
      "required": ["userId", "status", "items", "updatedAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Collection of all orders."
    }
  }
}
